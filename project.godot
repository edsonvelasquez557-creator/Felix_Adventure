[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_hitbox"
2d_physics/layer_5="enemy_hitbox"
2d_physics/layer_6="player_hurtbox"
2d_physics/layer_7="enemy_hurtbox"
2d_physics/layer_8="pickups"
2d_physics/layer_9="triggers"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.078, 0.067, 0.122, 1)
